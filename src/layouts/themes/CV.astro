---
import Avatar from '../../components/Avatar.astro';
const { profile, assetBase = '/' } = Astro.props;
const education = Array.isArray(profile.education)
  ? profile.education
  : profile.education
    ? [profile.education]
    : [];
const certifications = profile.certifications ?? [];
const honors = profile.honors ?? [];
const interests = profile.interests ?? [];
const showCredentials = certifications.length > 0 || honors.length > 0;
const resumePath = profile.resume
  ? profile.resume.startsWith('http')
    ? profile.resume
    : `${assetBase}${profile.resume.replace(/^\//, '')}`
  : '';
---
<div class="theme-cv">
  <header class="cv-header">
    <div class="cv-identity">
      <h1>{profile.name}</h1>
      <p class="cv-role">{profile.role}</p>
      <p class="cv-meta">
        <span>{profile.location}</span>
        <span aria-hidden="true">·</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <span aria-hidden="true">·</span>
        <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <span aria-hidden="true">·</span>
        <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
      </p>
      <div class="cv-actions">
        {resumePath && (
          <a class="cv-btn" href={resumePath} target="_blank" rel="noreferrer">Download resume (PDF)</a>
        )}
        <a class="cv-btn cv-btn-secondary" href={`mailto:${profile.email}`}>Email</a>
      </div>
    </div>
    <Avatar profile={profile} assetBase={assetBase} size="lg" class="cv-photo" />
  </header>

  <section class="cv-section" id="about">
    <h2>Summary</h2>
    <p class="cv-summary">{profile.tagline} {profile.about}</p>
  </section>

  <section class="cv-section" id="experience">
    <h2>Experience</h2>
    {profile.experience.map((item) => (
      <article class="cv-item">
        <div class="cv-item-top">
          <h3>{item.title}</h3>
          <time>{item.date}</time>
        </div>
        <p class="cv-org">{item.organization}</p>
        <p class="cv-detail">{item.summary}</p>
      </article>
    ))}
  </section>

  <section class="cv-section" id="education">
    <h2>Education</h2>
    {education.map((item) => (
      <article class="cv-item">
        <div class="cv-item-top">
          <h3>{item.degree}</h3>
          <time>{item.detail}</time>
        </div>
        <p class="cv-org">{item.school}</p>
      </article>
    ))}
  </section>

  {profile.projects?.length > 0 && (
    <section class="cv-section" id="work">
      <h2>Selected work</h2>
      {profile.projects.map((project) => (
        <article class="cv-item">
          <div class="cv-item-top">
            <h3>
              <a href={project.link} target="_blank" rel="noreferrer">{project.title}</a>
            </h3>
            <span class="cv-kind">{project.kind}</span>
          </div>
          <p class="cv-detail">{project.summary}</p>
        </article>
      ))}
    </section>
  )}

  <section class="cv-section" id="skills">
    <h2>Skills</h2>
    <p class="cv-skills">{profile.skills.join(' · ')}</p>
  </section>

  {showCredentials && (
    <section class="cv-section" id="credentials">
      <h2>Credentials & honors</h2>
      <ul class="cv-list">
        {certifications.map((item) => (
          <li>
            <strong>{item.name}</strong>
            {(item.issuer || item.detail) && (
              <span> — {[item.issuer, item.detail].filter(Boolean).join(', ')}</span>
            )}
          </li>
        ))}
        {honors.map((item) => (
          <li>
            <strong>{item.title}</strong>
            {item.detail && <span> — {item.detail}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {interests.length > 0 && (
    <section class="cv-section" id="interests">
      <h2>Interests</h2>
      <p class="cv-skills">{interests.join(' · ')}</p>
    </section>
  )}
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap');

.theme-cv {
  --ink: #171717;
  --muted: #5c5c5c;
  --line: #dcdcdc;
  --paper: #f7f7f5;
  --accent: #0f5c56;
  max-width: 760px;
  margin: 0 auto;
  padding: 40px 24px 72px;
  color: var(--ink);
  background: var(--paper);
  font-family: 'Source Sans 3', system-ui, sans-serif;
  min-height: 100vh;
}

.theme-cv * { box-sizing: border-box; }

.cv-header {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 24px;
  align-items: start;
  padding-bottom: 28px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 28px;
}

.cv-header h1 {
  margin: 0 0 6px;
  font: 700 clamp(32px, 5vw, 42px)/1.1 'Source Serif 4', Georgia, serif;
  letter-spacing: -0.02em;
}

.cv-role {
  margin: 0 0 10px;
  font: 600 16px/1.4 'Source Sans 3', system-ui, sans-serif;
  color: var(--ink);
}

.cv-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 8px;
  margin: 0 0 16px;
  color: var(--muted);
  font: 400 14px/1.5 'Source Sans 3', system-ui, sans-serif;
}

.cv-meta a {
  color: var(--accent);
  text-decoration: none;
}

.cv-meta a:hover { text-decoration: underline; }

.cv-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.cv-btn {
  display: inline-flex;
  align-items: center;
  min-height: 36px;
  padding: 0 14px;
  border-radius: 4px;
  background: var(--ink);
  color: #fff;
  text-decoration: none;
  font: 600 13px/1 'Source Sans 3', system-ui, sans-serif;
}

.cv-btn-secondary {
  background: transparent;
  color: var(--ink);
  border: 1px solid var(--line);
}

:global(.cv-photo) {
  width: 112px !important;
  height: 112px !important;
  border-radius: 6px !important;
  object-fit: cover;
  border: 1px solid var(--line);
}

:global(.avatar-initials.cv-photo) {
  display: grid;
  place-items: center;
  background: #e8e8e4;
  color: var(--ink);
  font: 700 28px 'Source Serif 4', Georgia, serif;
}

.cv-section {
  margin-bottom: 28px;
  padding-bottom: 8px;
}

.cv-section h2 {
  margin: 0 0 14px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--ink);
  font: 700 13px/1 'Source Sans 3', system-ui, sans-serif;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.cv-summary {
  margin: 0;
  color: var(--muted);
  font: 400 15px/1.65 'Source Sans 3', system-ui, sans-serif;
}

.cv-item {
  margin-bottom: 16px;
}

.cv-item-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: baseline;
  flex-wrap: wrap;
}

.cv-item h3 {
  margin: 0;
  font: 700 16px/1.3 'Source Sans 3', system-ui, sans-serif;
}

.cv-item h3 a {
  color: inherit;
  text-decoration: none;
}

.cv-item h3 a:hover {
  color: var(--accent);
  text-decoration: underline;
}

.cv-item time,
.cv-kind {
  color: var(--muted);
  font: 600 13px/1.3 'Source Sans 3', system-ui, sans-serif;
  white-space: nowrap;
}

.cv-org {
  margin: 2px 0 6px;
  color: var(--ink);
  font: 600 14px/1.4 'Source Sans 3', system-ui, sans-serif;
}

.cv-detail {
  margin: 0;
  color: var(--muted);
  font: 400 14px/1.55 'Source Sans 3', system-ui, sans-serif;
}

.cv-skills {
  margin: 0;
  color: var(--ink);
  font: 400 14px/1.7 'Source Sans 3', system-ui, sans-serif;
}

.cv-list {
  margin: 0;
  padding-left: 18px;
  color: var(--muted);
  font: 400 14px/1.7 'Source Sans 3', system-ui, sans-serif;
}

.cv-list strong { color: var(--ink); }

@media (max-width: 640px) {
  .cv-header {
    grid-template-columns: 1fr;
  }

  :global(.cv-photo) {
    order: -1;
  }
}

@media print {
  .theme-cv {
    max-width: none;
    padding: 0;
    background: #fff;
  }

  .cv-actions { display: none; }

  .cv-btn { display: none; }

  a { color: inherit !important; text-decoration: none !important; }
}
</style>
