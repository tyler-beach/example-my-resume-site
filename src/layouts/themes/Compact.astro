---
import Avatar from '../../components/Avatar.astro';
import ExperienceDetails from '../../components/ExperienceDetails.astro';
const { profile, assetBase = '/' } = Astro.props;
const education = Array.isArray(profile.education) ? profile.education : profile.education ? [profile.education] : [];
const certifications = profile.certifications ?? [];
const honors = profile.honors ?? [];
const interests = profile.interests ?? [];
const learning = profile.learning ?? [];
const resumeHref = profile.resume
  ? profile.resume.startsWith('http') ? profile.resume : `${assetBase}${profile.resume.replace(/^\//, '')}`
  : '';
const showCredentials = certifications.length > 0 || honors.length > 0;
---
<div class="theme-compact">
  <header class="cp-hero">
    <div class="cp-hero-copy">
      <h1>{profile.name}</h1>
      <p class="cp-role">{profile.role}</p>
      <p class="cp-tagline">{profile.tagline}</p>
      <p class="cp-meta">
        <span>{profile.location}</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
        {resumeHref && <a href={resumeHref} target="_blank" rel="noreferrer">Resume PDF</a>}
      </p>
    </div>
    <Avatar profile={profile} assetBase={assetBase} size="lg" class="cp-photo" />
  </header>

  <section class="cp-section">
    <h2>About</h2>
    <div>
      <p>{profile.about}</p>
      <div class="cp-chips">
        {profile.skills.map((skill) => <span>{skill}</span>)}
      </div>
    </div>
  </section>

  <section class="cp-section" id="experience">
    <h2>Experience</h2>
    <div class="cp-stack">
      {profile.experience.map((item) => (
        <article class="cp-job">
          <header>
            <div>
              <h3>{item.title}</h3>
              <p class="cp-org">{item.organization}</p>
            </div>
            <time>{item.date}</time>
          </header>
          <ExperienceDetails item={item} />
        </article>
      ))}
    </div>
  </section>

  <section class="cp-section" id="projects">
    <h2>Projects</h2>
    <div class="cp-projects">
      {profile.projects.map((project) => {
        const detailHref = project.slug ? `${assetBase}projects/${project.slug}/` : '';
        return (
          <article class="cp-project">
            <h3>
              {detailHref ? <a href={detailHref}>{project.title}</a> : project.title}
            </h3>
            <p>{project.summary}</p>
            {project.skills?.length > 0 && (
              <ul class="cp-tags">
                {project.skills.map((skill) => <li>{skill}</li>)}
              </ul>
            )}
            <p class="cp-project-links">
              {detailHref && <a href={detailHref}>Details</a>}
              {project.demo && <a href={project.demo} target="_blank" rel="noreferrer">Demo</a>}
              {project.link && <a href={project.link} target="_blank" rel="noreferrer">Repo</a>}
            </p>
          </article>
        );
      })}
    </div>
  </section>

  <section class="cp-section" id="education">
    <h2>Education</h2>
    <div class="cp-stack">
      {education.map((item) => (
        <article class="cp-job">
          <header>
            <div>
              <h3>{item.degree}</h3>
              <p class="cp-org">{item.school}</p>
            </div>
            <time>{item.detail}</time>
          </header>
        </article>
      ))}
    </div>
  </section>

  {(interests.length > 0 || learning.length > 0) && (
    <section class="cp-section">
      <h2>More</h2>
      <div>
        {interests.length > 0 && (
          <p><strong>Interests:</strong> {interests.join(' · ')}</p>
        )}
        {learning.length > 0 && (
          <p><strong>Learning:</strong> {learning.join(' · ')}</p>
        )}
      </div>
    </section>
  )}

  {showCredentials && (
    <section class="cp-section">
      <h2>Credentials</h2>
      <ul class="cp-list">
        {certifications.map((item) => (
          <li>{item.name}{item.issuer ? ` · ${item.issuer}` : ''}</li>
        ))}
        {honors.map((item) => (
          <li>{item.title}{item.detail ? ` · ${item.detail}` : ''}</li>
        ))}
      </ul>
    </section>
  )}
</div>

<style>
.theme-compact {
  --paper: #fff;
  --ink: #15171c;
  --text: #3d414a;
  --muted: #6b707a;
  --rule: #e5e7eb;
  --wash: #f2f3f5;
  --accent: #0f766e;
  --label-col: 8.5rem;
  --gutter: 2rem;
  --page: 46rem;
  max-width: calc(var(--label-col) + var(--gutter) + var(--page));
  margin: 0 auto;
  padding: 40px 20px 96px;
  background: var(--paper);
  color: var(--text);
  font: 15px/1.6 system-ui, -apple-system, sans-serif;
  min-height: 100vh;
}
.theme-compact * { box-sizing: border-box; }
.cp-hero {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 24px;
  align-items: start;
  margin-bottom: 36px;
  padding-bottom: 28px;
  border-bottom: 1px solid var(--rule);
}
.cp-hero h1 {
  margin: 0 0 4px;
  color: var(--ink);
  font: 600 clamp(28px, 4vw, 36px)/1.15 system-ui, sans-serif;
}
.cp-role {
  margin: 0 0 8px;
  color: var(--ink);
  font: 500 15px/1.4 system-ui, sans-serif;
}
.cp-tagline {
  margin: 0 0 14px;
  max-width: 34rem;
  color: var(--text);
}
.cp-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}
.cp-meta a { color: var(--accent); text-decoration: none; }
.cp-meta a:hover { text-decoration: underline; }
:global(.cp-photo) {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  object-fit: cover;
  background: var(--wash);
}
:global(.avatar-initials.cp-photo) {
  display: grid;
  place-items: center;
  font: 600 28px system-ui, sans-serif;
  color: var(--ink);
}
.cp-section {
  display: grid;
  grid-template-columns: var(--label-col) minmax(0, 1fr);
  column-gap: var(--gutter);
  margin-bottom: 28px;
}
.cp-section h2 {
  margin: 0;
  color: var(--ink);
  font: 600 14px/1.5 system-ui, sans-serif;
}
.cp-section > div p,
.cp-section > .cp-stack,
.cp-section > .cp-projects,
.cp-section > .cp-list {
  margin: 0;
}
.cp-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 12px;
}
.cp-chips span {
  padding: 2px 8px;
  background: var(--wash);
  border-radius: 6px;
  color: var(--text);
  font: 500 12px/1.5 system-ui, sans-serif;
}
.cp-stack { display: flex; flex-direction: column; gap: 20px; }
.cp-job header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 4px;
}
.cp-job h3 {
  margin: 0;
  color: var(--ink);
  font: 600 15px/1.4 system-ui, sans-serif;
}
.cp-org {
  margin: 0;
  color: var(--accent);
  font: 500 13px/1.4 system-ui, sans-serif;
}
.cp-job time {
  flex-shrink: 0;
  color: var(--muted);
  font: 13px/1.4 system-ui, sans-serif;
  white-space: nowrap;
}
:global(.theme-compact .exp-summary) {
  margin: 6px 0 0;
  color: var(--text);
  font: 14px/1.55 system-ui, sans-serif;
}
:global(.theme-compact .exp-highlights) {
  margin: 6px 0 0;
  padding-left: 18px;
  color: var(--muted);
  font: 13px/1.5 system-ui, sans-serif;
}
.cp-projects {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px 20px;
}
.cp-project h3 {
  margin: 0 0 4px;
  font: 600 15px/1.35 system-ui, sans-serif;
}
.cp-project h3 a {
  color: var(--ink);
  text-decoration: none;
}
.cp-project h3 a:hover { color: var(--accent); text-decoration: underline; }
.cp-project p {
  margin: 0;
  color: var(--text);
  font: 14px/1.5 system-ui, sans-serif;
}
.cp-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 8px 0 0;
  padding: 0;
  list-style: none;
}
.cp-tags li {
  padding: 1px 8px;
  background: var(--wash);
  border-radius: 6px;
  font: 500 12px/1.5 system-ui, sans-serif;
  color: var(--text);
}
.cp-project-links {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 8px !important;
  font: 600 13px/1 system-ui, sans-serif !important;
}
.cp-project-links a { color: var(--accent); text-decoration: none; }
.cp-project-links a:hover { text-decoration: underline; }
.cp-list {
  margin: 0;
  padding-left: 18px;
  color: var(--text);
  font: 14px/1.6 system-ui, sans-serif;
}
.cp-section strong { color: var(--ink); font-weight: 600; }
@media (max-width: 720px) {
  .cp-section {
    grid-template-columns: 1fr;
    row-gap: 10px;
  }
  .cp-section h2 {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--rule);
  }
  .cp-projects { grid-template-columns: 1fr; }
  .cp-hero { grid-template-columns: 1fr; }
  :global(.cp-photo) { order: -1; }
}
</style>
