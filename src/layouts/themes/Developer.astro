---
import Avatar from '../../components/Avatar.astro';
import ExperienceDetails from '../../components/ExperienceDetails.astro';
import ProjectCard from '../../components/ProjectCard.astro';
const { profile, assetBase = '/' } = Astro.props;
const education = Array.isArray(profile.education) ? profile.education : profile.education ? [profile.education] : [];
const certifications = profile.certifications ?? [];
const honors = profile.honors ?? [];
const interests = profile.interests ?? [];
const learning = profile.learning ?? [];
const careerHighlights = profile.careerHighlights ?? [];
const resumeHref = profile.resume
  ? profile.resume.startsWith('http') ? profile.resume : `${assetBase}${profile.resume.replace(/^\//, '')}`
  : '';
const showCredentials = certifications.length > 0 || honors.length > 0;
const showInterests = interests.length > 0 || learning.length > 0;
---
<div class="theme-developer">
  <header class="dev-nav">
    <div class="dev-brand">
      <Avatar profile={profile} assetBase={assetBase} size="sm" class="dev-avatar" />
      <strong>{profile.name.split(' ')[0]}<span>.</span></strong>
    </div>
    <nav aria-label="Main">
      <a href="#projects">Projects</a>
      <a href="#experience">Experience</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="dev-hero">
    <div>
      {profile.badge && <p class="badge">{profile.badge}</p>}
      <h1>{profile.name}</h1>
      <p class="intro"><span>{profile.role}</span> — {profile.tagline}</p>
      <div class="tag-row">{profile.skills.slice(0, 5).map((skill) => <span>{skill}</span>)}</div>
      <div class="dev-hero-actions">
        {resumeHref && <a class="dev-cta" href={resumeHref} target="_blank" rel="noreferrer">Resume PDF</a>}
        <a class="dev-cta ghost" href={`mailto:${profile.email}`}>Email</a>
      </div>
    </div>
  </section>

  <section class="dev-section" id="projects">
    <div class="section-title"><span>Projects</span></div>
    <div class="dev-projects">
      {profile.projects.map((project) => (
        <ProjectCard project={project} assetBase={assetBase} />
      ))}
    </div>
  </section>

  <section class="dev-section" id="experience">
    <div class="section-title"><span>02 / Experience</span></div>
    <div class="dev-timeline">
      {profile.experience.map((item) => (
        <article>
          <time>{item.date}</time>
          <div>
            <h3>{item.title}</h3>
            <p class="org">{item.organization}</p>
            <ExperienceDetails item={item} />
          </div>
        </article>
      ))}
    </div>
  </section>

  {careerHighlights.length > 0 && (
    <section class="dev-section" id="highlights">
      <div class="section-title"><span>Highlights</span></div>
      <ul class="dev-bullets">
        {careerHighlights.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  )}

  <section class="dev-section split" id="about">
    <div>
      <div class="section-title"><span>03 / About</span></div>
      <p>{profile.about}</p>
      <div class="tag-row">{profile.skills.map((skill) => <span>{skill}</span>)}</div>
    </div>
    <div class="dev-photo-panel">
      <Avatar profile={profile} assetBase={assetBase} size="lg" />
    </div>
  </section>

  <section class="dev-section" id="education">
    <div class="section-title"><span>04 / Education</span></div>
    <div class="dev-timeline compact">
      {education.map((item) => (
        <article>
          <time>{item.detail}</time>
          <div>
            <h3>{item.degree}</h3>
            <p class="org">{item.school}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  {showInterests && (
    <section class="dev-section" id="interests">
      <div class="section-title"><span>05 / Interests & learning</span></div>
      <div class="interest-grid">
        {interests.length > 0 && (
          <div>
            <p class="subhead">Interests</p>
            <div class="tag-row">{interests.map((item) => <span>{item}</span>)}</div>
          </div>
        )}
        {learning.length > 0 && (
          <div>
            <p class="subhead">Currently learning</p>
            <div class="tag-row">{learning.map((item) => <span>{item}</span>)}</div>
          </div>
        )}
      </div>
    </section>
  )}

  {showCredentials && (
    <section class="dev-section" id="credentials">
      <div class="section-title"><span>06 / Credentials & honors</span></div>
      <ul class="dev-cred-list">
        {certifications.map((item) => (
          <li><strong>{item.name}</strong>{item.issuer ? ` · ${item.issuer}` : ''}</li>
        ))}
        {honors.map((item) => (
          <li><strong>{item.title}</strong></li>
        ))}
      </ul>
    </section>
  )}

  <section class="dev-contact" id="contact">
    <h2>Let's connect.</h2>
    <div class="dev-links">
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
      {resumeHref && <a href={resumeHref} target="_blank" rel="noreferrer">Resume PDF</a>}
    </div>
  </section>
</div>

<style>
.theme-developer{--bg:#081220;--panel:#0f2633;--line:#1e334c;--text:#f5f8fd;--muted:#b5c5d7;--accent:#a7f3d0;--teal:#0f766e;background:var(--bg);color:var(--text);font-family:'Segoe UI',system-ui,sans-serif;min-height:100vh;padding-bottom:72px}
.theme-developer *{box-sizing:border-box}
.dev-nav{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px clamp(16px,5vw,64px);border-bottom:1px solid var(--line);flex-wrap:wrap}
.dev-brand{display:flex;align-items:center;gap:10px}
.dev-brand strong{font-size:22px}.dev-brand span{color:var(--accent)}
:global(.dev-avatar){width:36px;height:36px;border-radius:8px;object-fit:cover}
:global(.avatar-initials.dev-avatar){display:grid;place-items:center;background:#0f2633;color:var(--accent);font:700 12px ui-monospace,monospace}
.dev-nav a{color:var(--muted);text-decoration:none;margin-left:16px;font:12px ui-monospace,monospace}
.dev-nav a:hover{color:var(--accent)}
.dev-hero{padding:clamp(28px,5vw,48px) clamp(16px,5vw,64px)}
.badge{display:inline-block;border:1px solid var(--teal);color:var(--accent);border-radius:6px;padding:6px 10px;font:11px system-ui,sans-serif;margin:0 0 14px}
.dev-hero h1{font:700 clamp(28px,4.5vw,42px)/1.1 system-ui,sans-serif;letter-spacing:-.02em;margin:0 0 12px}
.intro{font:15px/1.65 system-ui,sans-serif;color:var(--muted);max-width:560px;margin:0}
.intro span{color:var(--accent);font-weight:600}
.tag-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
.tag-row span{border:1px solid var(--line);padding:6px 9px;border-radius:6px;font:11px ui-monospace,monospace;color:#dbe3eb}
.dev-hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
.dev-cta{display:inline-flex;align-items:center;padding:10px 14px;border-radius:8px;background:var(--accent);color:#081220;text-decoration:none;font:700 12px system-ui,sans-serif}
.dev-cta.ghost{background:transparent;border:1px solid var(--line);color:var(--text)}
.dev-section{padding:8px clamp(16px,5vw,64px) 36px}
.section-title{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding:14px 0;font:12px system-ui,sans-serif;color:#9cb5c7;margin-bottom:4px}
.dev-projects{--pc-line:var(--line);--pc-muted:var(--muted);--pc-accent:var(--accent)}
.dev-timeline article{display:grid;grid-template-columns:120px 1fr;gap:14px;padding:14px 0;border-bottom:1px solid var(--line)}
.dev-timeline.compact article{padding:10px 0}
.dev-timeline time{font:11px ui-monospace,monospace;color:#64748b}
.dev-timeline h3{margin:0 0 2px;font:16px system-ui,sans-serif}
.dev-timeline .org,.org{color:var(--accent);font-weight:600;margin:0 0 6px;font-size:13px}
:global(.theme-developer .exp-summary){color:var(--muted);font:13px/1.55 system-ui,sans-serif;margin:0 0 8px}
:global(.theme-developer .exp-highlights){margin:0;padding-left:18px;color:var(--muted);font:13px/1.5 system-ui,sans-serif}
:global(.theme-developer .exp-highlights li){margin-bottom:4px}
.dev-bullets{margin:0;padding-left:18px;color:var(--muted);font:14px/1.55 system-ui,sans-serif}
.dev-cred-list{margin:0;padding-left:18px;color:var(--muted);font:14px/1.65 system-ui,sans-serif}
.dev-cred-list strong{color:var(--text)}
.interest-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.subhead{margin:0 0 4px;font:11px ui-monospace,monospace;color:var(--accent);letter-spacing:.06em;text-transform:uppercase}
.split{display:grid;grid-template-columns:1.2fr .8fr;gap:24px;align-items:center}
.dev-photo-panel{display:grid;place-items:center}
:global(.theme-developer .avatar-lg){width:200px;height:200px;border-radius:18px;object-fit:cover;border:1px solid var(--line)}
:global(.theme-developer .avatar-initials.avatar-lg){display:grid;place-items:center;background:var(--panel);font:48px ui-monospace,monospace;color:var(--accent)}
.dev-contact{margin:16px clamp(16px,5vw,64px) 40px;padding:24px;border:1px solid var(--line);border-radius:8px;background:#061018}
.dev-contact h2{font:22px system-ui,sans-serif;margin:0 0 14px}
.dev-links{display:flex;gap:18px;flex-wrap:wrap}
.dev-links a{color:var(--accent);font:14px system-ui,sans-serif}
@media(max-width:850px){
  .split,.dev-timeline article,.interest-grid{grid-template-columns:1fr}
  .dev-nav a{margin-left:0;margin-right:12px}
}
</style>
