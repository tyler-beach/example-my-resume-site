---
import Avatar from '../../components/Avatar.astro';
const { profile, assetBase = '/' } = Astro.props;
const education = Array.isArray(profile.education)
  ? profile.education
  : profile.education
    ? [profile.education]
    : [];
const certifications = profile.certifications ?? [];
const honors = profile.honors ?? [];
const interests = profile.interests ?? [];
const learning = profile.learning ?? [];
const services = profile.services ?? [];
const showCredentials = certifications.length > 0 || honors.length > 0;
const showInterests = interests.length > 0 || learning.length > 0;
const headline = profile.headline || profile.tagline;
const photoSrc =
  typeof profile.photo === 'string' && profile.photo.trim()
    ? profile.photo.startsWith('http')
      ? profile.photo
      : `${assetBase}${profile.photo.replace(/^\//, '')}`
    : '';
---
<div class="theme-refined">
  <nav class="rf-dock" aria-label="Main">
    <a href="#top" class="rf-dock-home" aria-label="Home">⌂</a>
    <a href="#work">Work</a>
    <a href="#experience">Experience</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </nav>

  <header class="rf-hero" id="top">
    <p class="rf-kicker">{profile.badge || profile.location}</p>
    <h1>{headline}</h1>
    <p class="rf-lede">{profile.role}<br />{profile.location}.</p>
    <div class="rf-actions">
      <a class="rf-btn rf-btn-primary" href="#work">See work</a>
      <a class="rf-btn rf-btn-ghost" href={`mailto:${profile.email}`}>Get in touch</a>
    </div>
    {photoSrc && (
      <div class="rf-hero-photo">
        <img src={photoSrc} alt={`Portrait of ${profile.name}`} width="480" height="560" />
        <div class="rf-hero-fade" aria-hidden="true"></div>
      </div>
    )}
  </header>

  <section class="rf-section" id="work">
    <div class="rf-section-head">
      <h2>Selected work</h2>
      <span class="rf-count">({String(profile.projects.length).padStart(1, '0')})</span>
    </div>
    <div class="rf-work">
      {profile.projects.map((project) => (
        <a class="rf-work-card" href={project.link} target="_blank" rel="noreferrer">
          <span class="rf-kind">{project.kind}</span>
          <h3>{project.title}</h3>
          <p>{project.summary}</p>
          <span class="rf-card-link">Open ↗</span>
        </a>
      ))}
    </div>
  </section>

  {services.length > 0 && (
    <section class="rf-section" id="services">
      <div class="rf-section-head">
        <h2>Focus areas</h2>
        <span class="rf-count">({String(services.length).padStart(2, '0')})</span>
      </div>
      <div class="rf-services">
        {services.map((item, i) => (
          <article>
            <span class="rf-num">{String(i + 1).padStart(2, '0')}.</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="rf-section" id="experience">
    <div class="rf-section-head">
      <h2>Experience</h2>
      <span class="rf-count">({String(profile.experience.length).padStart(2, '0')})</span>
    </div>
    <div class="rf-experience">
      {profile.experience.map((item) => (
        <article>
          <time>{item.date}</time>
          <div>
            <h3>{item.title}</h3>
            <p class="rf-org">{item.organization}</p>
            <p>{item.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="rf-section rf-split" id="about">
    <div>
      <div class="rf-section-head">
        <h2>About</h2>
      </div>
      <p class="rf-about">{profile.about}</p>
      <p class="rf-skills-label">Skills</p>
      <div class="rf-chips">
        {profile.skills.map((skill) => <span>{skill}</span>)}
      </div>

      <p class="rf-skills-label">Education</p>
      <div class="rf-edu">
        {education.map((item) => (
          <div>
            <strong>{item.degree}</strong>
            <span>{item.school} · {item.detail}</span>
          </div>
        ))}
      </div>

      {showCredentials && (
        <>
          <p class="rf-skills-label">Credentials & honors</p>
          <div class="rf-edu">
            {certifications.map((item) => (
              <div>
                <strong>{item.name}</strong>
                <span>{[item.issuer, item.detail].filter(Boolean).join(' · ')}</span>
              </div>
            ))}
            {honors.map((item) => (
              <div>
                <strong>{item.title}</strong>
                {item.detail && <span>{item.detail}</span>}
              </div>
            ))}
          </div>
        </>
      )}

      {showInterests && (
        <>
          {interests.length > 0 && (
            <>
              <p class="rf-skills-label">Interests</p>
              <div class="rf-chips">
                {interests.map((item) => <span>{item}</span>)}
              </div>
            </>
          )}
          {learning.length > 0 && (
            <>
              <p class="rf-skills-label">Currently learning</p>
              <div class="rf-chips">
                {learning.map((item) => <span>{item}</span>)}
              </div>
            </>
          )}
        </>
      )}
    </div>
    <div class="rf-about-photo">
      <Avatar profile={profile} assetBase={assetBase} size="lg" class="rf-avatar" />
      <p class="rf-name">{profile.name}</p>
      <p class="rf-tagline">{profile.tagline}</p>
    </div>
  </section>

  <section class="rf-contact" id="contact">
    <h2>Ready to talk?</h2>
    <p>Have an idea, a security problem, or a student question? Let’s shape it into something you’re proud to show.</p>
    <div class="rf-actions">
      <a class="rf-btn rf-btn-primary" href={`mailto:${profile.email}`}>Email me</a>
      <a class="rf-btn rf-btn-ghost" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a class="rf-btn rf-btn-ghost" href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
    </div>
  </section>

  <footer class="rf-footer">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <span>{profile.location}</span>
  </footer>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

.theme-refined {
  --bg: #0b0b0c;
  --panel: #141416;
  --panel-2: #1a1a1d;
  --line: rgba(255, 255, 255, 0.08);
  --text: #f4f1ea;
  --muted: #9a968c;
  --accent: #c9d4a3;
  --accent-ink: #1a1f12;
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
}

.theme-refined * { box-sizing: border-box; }

.rf-dock {
  position: sticky;
  top: 18px;
  z-index: 40;
  width: max-content;
  max-width: calc(100% - 32px);
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(20, 20, 22, 0.82);
  backdrop-filter: blur(16px);
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
}

.rf-dock a {
  color: var(--muted);
  text-decoration: none;
  font: 500 12px/1 'Plus Jakarta Sans', system-ui, sans-serif;
  letter-spacing: 0.02em;
  padding: 10px 14px;
  border-radius: 999px;
  transition: color 0.18s ease, background 0.18s ease;
}

.rf-dock a:hover,
.rf-dock a:focus-visible {
  color: var(--text);
  background: rgba(255, 255, 255, 0.06);
  outline: none;
}

.rf-dock-home {
  width: 36px;
  height: 36px;
  display: grid !important;
  place-items: center;
  padding: 0 !important;
  background: rgba(255, 255, 255, 0.08);
  color: var(--text) !important;
}

.rf-hero {
  position: relative;
  max-width: 920px;
  margin: 0 auto;
  padding: clamp(56px, 10vw, 110px) 24px 48px;
  text-align: center;
}

.rf-kicker {
  margin: 0 0 18px;
  color: var(--accent);
  font: 600 11px/1.4 'Plus Jakarta Sans', system-ui, sans-serif;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.rf-hero h1 {
  margin: 0 auto 18px;
  max-width: 14ch;
  font: 600 clamp(42px, 8vw, 84px)/1.02 Fraunces, Georgia, serif;
  letter-spacing: -0.04em;
  color: #faf7f0;
}

.rf-lede {
  margin: 0 auto 28px;
  max-width: 420px;
  color: var(--muted);
  font: 400 16px/1.65 'Plus Jakarta Sans', system-ui, sans-serif;
}

.rf-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
}

.rf-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 18px;
  border-radius: 999px;
  text-decoration: none;
  font: 600 13px/1 'Plus Jakarta Sans', system-ui, sans-serif;
  transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
}

.rf-btn:hover { transform: translateY(-1px); }

.rf-btn-primary {
  color: var(--accent-ink);
  background: var(--accent);
  box-shadow: 0 0 0 1px rgba(201, 212, 163, 0.25), 0 10px 30px rgba(201, 212, 163, 0.18);
}

.rf-btn-ghost {
  color: var(--text);
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.03);
}

.rf-hero-photo {
  position: relative;
  width: min(420px, 78vw);
  margin: 56px auto 0;
  border-radius: 28px;
  overflow: hidden;
  background: #151515;
  mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
}

.rf-hero-photo img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: cover;
  filter: contrast(1.05) saturate(0.9);
}

.rf-hero-fade {
  position: absolute;
  inset: auto 0 0;
  height: 40%;
  background: linear-gradient(to bottom, transparent, var(--bg));
  pointer-events: none;
}

.rf-section {
  max-width: 1080px;
  margin: 0 auto;
  padding: 28px 24px 64px;
}

.rf-section-head {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 22px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--line);
}

.rf-section-head h2 {
  margin: 0;
  font: 500 clamp(28px, 4vw, 40px)/1 Fraunces, Georgia, serif;
  letter-spacing: -0.03em;
}

.rf-count {
  color: var(--muted);
  font: 500 13px/1 'Plus Jakarta Sans', system-ui, sans-serif;
}

.rf-work {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.rf-work-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-height: 220px;
  padding: 24px;
  border: 1px solid var(--line);
  border-radius: 22px;
  background: linear-gradient(160deg, var(--panel), var(--panel-2));
  color: inherit;
  text-decoration: none;
  transition: border-color 0.18s ease, transform 0.18s ease, background 0.18s ease;
}

.rf-work-card:hover {
  transform: translateY(-3px);
  border-color: rgba(201, 212, 163, 0.35);
}

.rf-kind {
  color: var(--accent);
  font: 600 11px/1.3 'Plus Jakarta Sans', system-ui, sans-serif;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.rf-work-card h3 {
  margin: 0;
  font: 500 26px/1.15 Fraunces, Georgia, serif;
  letter-spacing: -0.03em;
}

.rf-work-card p {
  margin: 0;
  flex: 1;
  color: var(--muted);
  font: 400 14px/1.65 'Plus Jakarta Sans', system-ui, sans-serif;
}

.rf-card-link {
  color: var(--text);
  font: 600 12px/1 'Plus Jakarta Sans', system-ui, sans-serif;
}

.rf-services {
  display: grid;
  gap: 0;
}

.rf-services article {
  display: grid;
  grid-template-columns: 64px 1fr;
  gap: 18px;
  padding: 22px 0;
  border-bottom: 1px solid var(--line);
}

.rf-num {
  color: var(--accent);
  font: 500 14px/1.4 'Plus Jakarta Sans', system-ui, sans-serif;
}

.rf-services h3 {
  margin: 0 0 6px;
  font: 500 22px/1.2 Fraunces, Georgia, serif;
}

.rf-services p,
.rf-experience p,
.rf-about,
.rf-edu span,
.rf-tagline {
  margin: 0;
  color: var(--muted);
  font: 400 15px/1.7 'Plus Jakarta Sans', system-ui, sans-serif;
}

.rf-experience article {
  display: grid;
  grid-template-columns: 140px 1fr;
  gap: 20px;
  padding: 22px 0;
  border-bottom: 1px solid var(--line);
}

.rf-experience time {
  color: var(--muted);
  font: 500 12px/1.4 'Plus Jakarta Sans', system-ui, sans-serif;
}

.rf-experience h3 {
  margin: 0 0 4px;
  font: 500 22px/1.2 Fraunces, Georgia, serif;
}

.rf-org {
  color: var(--accent) !important;
  font-weight: 600 !important;
  margin-bottom: 8px !important;
}

.rf-split {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 36px;
  align-items: start;
}

.rf-skills-label {
  margin: 28px 0 10px;
  color: var(--text);
  font: 600 11px/1 'Plus Jakarta Sans', system-ui, sans-serif;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.rf-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.rf-chips span {
  padding: 8px 12px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: #d9d4c8;
  font: 500 12px/1 'Plus Jakarta Sans', system-ui, sans-serif;
  background: rgba(255, 255, 255, 0.02);
}

.rf-edu {
  display: grid;
  gap: 12px;
}

.rf-edu strong {
  display: block;
  margin-bottom: 2px;
  font: 500 16px/1.3 Fraunces, Georgia, serif;
}

.rf-about-photo {
  padding: 28px;
  border: 1px solid var(--line);
  border-radius: 28px;
  background: var(--panel);
  text-align: center;
}

:global(.rf-avatar) {
  width: 180px !important;
  height: 180px !important;
  border-radius: 24px !important;
  object-fit: cover;
  margin: 0 auto 16px;
  border: 1px solid var(--line);
}

:global(.avatar-initials.rf-avatar) {
  display: grid;
  place-items: center;
  background: #222;
  color: var(--accent);
  font: 600 42px Fraunces, Georgia, serif;
}

.rf-name {
  margin: 0 0 8px;
  font: 500 24px/1.1 Fraunces, Georgia, serif;
}

.rf-contact {
  max-width: 760px;
  margin: 24px auto 48px;
  padding: clamp(40px, 7vw, 72px) 24px;
  text-align: center;
  border: 1px solid var(--line);
  border-radius: 32px;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(201, 212, 163, 0.12), transparent 55%),
    var(--panel);
}

.rf-contact h2 {
  margin: 0 0 12px;
  font: 500 clamp(36px, 6vw, 56px)/1.05 Fraunces, Georgia, serif;
  letter-spacing: -0.03em;
}

.rf-contact p {
  margin: 0 auto 28px;
  max-width: 460px;
  color: var(--muted);
  font: 400 16px/1.7 'Plus Jakarta Sans', system-ui, sans-serif;
}

.rf-footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  max-width: 1080px;
  margin: 0 auto;
  padding: 0 24px 40px;
  color: var(--muted);
  font: 400 12px/1.4 'Plus Jakarta Sans', system-ui, sans-serif;
}

@media (max-width: 860px) {
  .rf-work,
  .rf-split,
  .rf-experience article,
  .rf-services article {
    grid-template-columns: 1fr;
  }

  .rf-dock {
    top: 12px;
    overflow-x: auto;
  }

  .rf-dock a {
    padding: 10px 12px;
    white-space: nowrap;
  }

  .rf-experience time {
    margin-bottom: -8px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .rf-btn,
  .rf-work-card {
    transition: none;
  }

  .rf-btn:hover,
  .rf-work-card:hover {
    transform: none;
  }
}
</style>
