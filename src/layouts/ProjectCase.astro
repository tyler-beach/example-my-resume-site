---
const { profile, project, assetBase = '/' } = Astro.props;
const images = (project.images ?? []).map((src) =>
  src.startsWith('http') ? src : `${assetBase}${src.replace(/^\//, '')}`
);
const homeHref = assetBase;
const body = project.description || project.summary;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={project.summary} />
    <meta name="theme-color" content="#f8fafc" />
    <title>{project.title} · {profile.name}</title>
    <style>
      html, body { margin: 0; min-width: 320px; background: #f8fafc; }
      a { text-underline-offset: 3px; }
    </style>
  </head>
  <body>
    <article class="project-page">
      <p class="back"><a href={homeHref}>← Back</a></p>

      <header>
        <h1>{project.title}</h1>
        <p class="lede">{body}</p>
        <p class="links">
          {project.demo && <a href={project.demo} target="_blank" rel="noreferrer">Live demo</a>}
          {project.link && <a href={project.link} target="_blank" rel="noreferrer">Repository</a>}
        </p>
      </header>

      {project.highlights?.length > 0 && (
        <section>
          <h2>What it includes</h2>
          <ul>
            {project.highlights.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {project.skills?.length > 0 && (
        <section>
          <h2>Skills</h2>
          <p class="skills">{project.skills.join(' · ')}</p>
        </section>
      )}

      {images.length > 0 && (
        <section>
          <h2>Screenshots</h2>
          <div class="shots">
            {images.map((src, i) => (
              <img src={src} alt={`${project.title} screenshot ${i + 1}`} width="1200" height="675" loading="lazy" />
            ))}
          </div>
        </section>
      )}

      <footer>
        <a href={homeHref}>← {profile.name}</a>
      </footer>
    </article>
  </body>
</html>

<style>
.project-page {
  --ink: #081220;
  --muted: #475569;
  --line: #dbe3eb;
  --accent: #0f766e;
  max-width: 720px;
  margin: 0 auto;
  padding: 28px 20px 80px;
  color: var(--ink);
  font-family: system-ui, -apple-system, sans-serif;
}
.back { margin: 0 0 28px; }
.back a {
  color: var(--accent);
  text-decoration: none;
  font: 600 14px/1 system-ui, sans-serif;
}
header h1 {
  margin: 0 0 12px;
  font: 600 clamp(28px, 5vw, 40px)/1.15 Georgia, serif;
}
.lede {
  margin: 0 0 16px;
  color: var(--muted);
  font: 400 16px/1.6 system-ui, sans-serif;
}
.links {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin: 0 0 32px;
}
.links a {
  color: var(--accent);
  font: 600 14px/1 system-ui, sans-serif;
}
section {
  margin-bottom: 28px;
  padding-top: 20px;
  border-top: 1px solid var(--line);
}
section h2 {
  margin: 0 0 10px;
  font: 600 13px/1.3 system-ui, sans-serif;
  color: var(--ink);
}
section ul {
  margin: 0;
  padding-left: 18px;
  color: var(--muted);
  font: 400 15px/1.55 system-ui, sans-serif;
}
section li { margin-bottom: 6px; }
.skills {
  margin: 0;
  color: var(--muted);
  font: 400 14px/1.5 system-ui, sans-serif;
}
.shots {
  display: grid;
  gap: 12px;
}
.shots img {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid var(--line);
  background: #fff;
}
footer {
  margin-top: 36px;
  padding-top: 18px;
  border-top: 1px solid var(--line);
}
footer a {
  color: var(--accent);
  text-decoration: none;
  font: 600 14px/1 system-ui, sans-serif;
}
</style>
