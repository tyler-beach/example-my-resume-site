---
const { profile, project, assetBase = '/' } = Astro.props;
const cover = project.cover
  ? project.cover.startsWith('http')
    ? project.cover
    : `${assetBase}${project.cover.replace(/^\//, '')}`
  : '';
const images = (project.images ?? []).map((src) =>
  src.startsWith('http') ? src : `${assetBase}${src.replace(/^\//, '')}`
);
const homeHref = assetBase;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={project.summary} />
    <meta name="theme-color" content="#081220" />
    <title>{project.title} · {profile.name}</title>
    <style>
      html, body { margin: 0; min-width: 320px; background: #081220; }
      a { text-underline-offset: 3px; }
    </style>
  </head>
  <body>
    <article class="case">
      <header class="case-top">
        <a class="case-back" href={homeHref}>← Back to resume</a>
        <p class="case-kind">{project.kind}</p>
        <h1>{project.title}</h1>
        <p class="case-lede">{project.summary}</p>
        <div class="case-links">
          {project.demo && <a class="case-btn" href={project.demo} target="_blank" rel="noreferrer">Live demo ↗</a>}
          {project.link && <a class="case-btn ghost" href={project.link} target="_blank" rel="noreferrer">Repository ↗</a>}
        </div>
      </header>

      {cover && (
        <figure class="case-hero">
          <img src={cover} alt={`Cover for ${project.title}`} width="1200" height="675" />
        </figure>
      )}

      <section class="case-grid">
        <div>
          <h2>Problem</h2>
          <p>{project.problem}</p>
        </div>
        <div>
          <h2>Approach</h2>
          <p>{project.approach}</p>
        </div>
        <div>
          <h2>Outcome</h2>
          <p>{project.outcome}</p>
        </div>
      </section>

      {project.highlights?.length > 0 && (
        <section class="case-block">
          <h2>Highlights</h2>
          <ul>
            {project.highlights.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {project.skills?.length > 0 && (
        <section class="case-block">
          <h2>Stack & skills</h2>
          <div class="case-chips">
            {project.skills.map((skill) => <span>{skill}</span>)}
          </div>
        </section>
      )}

      {images.length > 0 && (
        <section class="case-block">
          <h2>Screenshots</h2>
          <div class="case-shots">
            {images.map((src, i) => (
              <figure>
                <img src={src} alt={`${project.title} screenshot ${i + 1}`} width="1200" height="675" loading="lazy" />
              </figure>
            ))}
          </div>
        </section>
      )}

      <footer class="case-footer">
        <p>{profile.name} · {profile.role}</p>
        <a href={homeHref}>Return to resume →</a>
      </footer>
    </article>
  </body>
</html>

<style>
.case {
  --ink: #f5f8fd;
  --muted: #b5c5d7;
  --line: #1e334c;
  --accent: #a7f3d0;
  --teal: #0f766e;
  --panel: #0f2633;
  max-width: 980px;
  margin: 0 auto;
  padding: 28px 20px 96px;
  color: var(--ink);
  font-family: system-ui, -apple-system, sans-serif;
}
.case-top { padding: 24px 0 8px; }
.case-back {
  display: inline-block;
  margin-bottom: 22px;
  color: var(--accent);
  text-decoration: none;
  font: 600 13px/1 system-ui, sans-serif;
}
.case-kind {
  margin: 0 0 10px;
  color: var(--accent);
  font: 600 11px/1.3 ui-monospace, Menlo, monospace;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.case h1 {
  margin: 0 0 12px;
  font: 600 clamp(32px, 5vw, 52px)/1.08 Georgia, serif;
  letter-spacing: -0.03em;
}
.case-lede {
  margin: 0 0 20px;
  max-width: 620px;
  color: var(--muted);
  font: 400 17px/1.6 system-ui, sans-serif;
}
.case-links { display: flex; flex-wrap: wrap; gap: 10px; }
.case-btn {
  display: inline-flex;
  align-items: center;
  min-height: 42px;
  padding: 0 16px;
  border-radius: 999px;
  background: var(--accent);
  color: #081220;
  text-decoration: none;
  font: 700 13px/1 system-ui, sans-serif;
}
.case-btn.ghost {
  background: transparent;
  border: 1px solid var(--line);
  color: var(--ink);
}
.case-hero {
  margin: 28px 0;
  border: 1px solid var(--line);
  border-radius: 18px;
  overflow: hidden;
  background: var(--panel);
}
.case-hero img,
.case-shots img {
  display: block;
  width: 100%;
  height: auto;
}
.case-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin: 28px 0;
}
.case-grid > div,
.case-block {
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(15, 38, 51, 0.65);
}
.case h2 {
  margin: 0 0 10px;
  font: 600 12px/1 ui-monospace, Menlo, monospace;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
}
.case-grid p,
.case-block p {
  margin: 0;
  color: var(--muted);
  font: 400 14px/1.6 system-ui, sans-serif;
}
.case-block { margin-bottom: 14px; }
.case-block ul {
  margin: 0;
  padding-left: 18px;
  color: var(--muted);
  font: 400 14px/1.6 system-ui, sans-serif;
}
.case-block li { margin-bottom: 6px; }
.case-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.case-chips span {
  padding: 7px 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  font: 500 12px/1 system-ui, sans-serif;
  color: #dbe3eb;
}
.case-shots {
  display: grid;
  gap: 12px;
  margin-top: 4px;
}
.case-shots figure {
  margin: 0;
  border: 1px solid var(--line);
  border-radius: 12px;
  overflow: hidden;
  background: #091524;
}
.case-footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 28px;
  padding-top: 18px;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font: 400 13px/1.4 system-ui, sans-serif;
}
.case-footer a { color: var(--accent); text-decoration: none; font-weight: 700; }
@media (max-width: 800px) {
  .case-grid { grid-template-columns: 1fr; }
}
</style>
