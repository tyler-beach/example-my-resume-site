---
import { profile } from '../data/profile.js';
import Editorial from '../layouts/themes/Editorial.astro';
import Developer from '../layouts/themes/Developer.astro';
import Professional from '../layouts/themes/Professional.astro';
import Refined from '../layouts/themes/Refined.astro';
import CV from '../layouts/themes/CV.astro';

const allowedThemes = ['editorial', 'developer', 'professional', 'refined', 'cv'];
const theme = allowedThemes.includes(profile.theme) ? profile.theme : 'cv';
const assetBase = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.tagline} />
    <meta name="theme-color" content="#f7f7f5" />
    <title>{profile.name} · Resume</title>
    <style>
      html, body { margin: 0; min-width: 320px; background: #f7f7f5; }
      a { text-underline-offset: 3px; }
    </style>
  </head>
  <body>
    {theme === 'cv' && <CV profile={profile} assetBase={assetBase} />}
    {theme === 'refined' && <Refined profile={profile} assetBase={assetBase} />}
    {theme === 'developer' && <Developer profile={profile} assetBase={assetBase} />}
    {theme === 'professional' && <Professional profile={profile} assetBase={assetBase} />}
    {theme === 'editorial' && <Editorial profile={profile} assetBase={assetBase} />}
  </body>
</html>
