---
import { profile } from '../data/profile.js';
import Compact from '../layouts/themes/Compact.astro';
import Developer from '../layouts/themes/Developer.astro';
import Professional from '../layouts/themes/Professional.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';

const assetBase = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.tagline} />
    <meta name="theme-color" content="#ffffff" />
    <title>{profile.name} · Resume</title>
    <style>
      html, body { margin: 0; min-width: 320px; }
      a { text-underline-offset: 3px; }
      [data-theme-panel][hidden] { display: none !important; }
    </style>
  </head>
  <body>
    <ThemeSwitcher />
    <div data-theme-panel="compact">
      <Compact profile={profile} assetBase={assetBase} />
    </div>
    <div data-theme-panel="professional" hidden>
      <Professional profile={profile} assetBase={assetBase} />
    </div>
    <div data-theme-panel="developer" hidden>
      <Developer profile={profile} assetBase={assetBase} />
    </div>
  </body>
</html>
