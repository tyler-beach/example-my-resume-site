---
import { stages } from '../data/profile.js';
import Student from '../layouts/themes/Student.astro';
import Emerging from '../layouts/themes/Emerging.astro';
import Professional from '../layouts/themes/Professional.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';

const assetBase = import.meta.env.BASE_URL;
const pageBase = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Example resume site with student, emerging, and professional journey layouts." />
    <meta name="theme-color" content="#000000" />
    <title>Tyler Beach · Journey examples</title>
    <style>
      html, body { margin: 0; min-width: 320px; background: #fff; }
      a { text-underline-offset: 3px; }
      [data-theme-panel][hidden] { display: none !important; }
    </style>
  </head>
  <body>
    <ThemeSwitcher />
    <div data-theme-panel="student">
      <Student profile={stages.student} assetBase={assetBase} pageBase={pageBase} />
    </div>
    <div data-theme-panel="emerging" hidden>
      <Emerging profile={stages.emerging} assetBase={assetBase} pageBase={pageBase} />
    </div>
    <div data-theme-panel="professional" hidden>
      <Professional profile={stages.professional} assetBase={assetBase} pageBase={pageBase} />
    </div>
  </body>
</html>
