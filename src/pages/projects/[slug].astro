---
import { profile, allProjects } from '../../data/profile.js';
import ProjectDetail from '../../layouts/ProjectDetail.astro';

export function getStaticPaths() {
  return allProjects().map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const assetBase = import.meta.env.BASE_URL;
const pageBase = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={project.summary || project.description || project.title} />
    <meta name="theme-color" content="#000000" />
    <title>{project.title} · {profile.name}</title>
    <style>
      html, body { margin: 0; min-width: 320px; background: #fff; }
      a { text-underline-offset: 3px; }
    </style>
  </head>
  <body>
    <ProjectDetail
      profile={profile}
      project={project}
      assetBase={assetBase}
      pageBase={pageBase}
    />
  </body>
</html>
